{
  "name": "kinky-kreatures-3d",
  "private": true,
  "description": "3D toy viewer (Wix custom element) and web models for kinkykreatures.au",
  "scripts": {
    "build": "esbuild src/kk-viewer.js --bundle --minify --format=iife --target=es2020 --define:__VERSION__=\\\"$npm_config_tag\\\" --outfile=dist/kk-viewer.js && esbuild src/kk-product.js --bundle --define:define=undefined --minify --format=iife --target=es2020 --define:__VERSION__=\\\"$npm_config_tag\\\" --outfile=dist/kk-product.js"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "esbuild": "^0.25.0",
    "qrcode-generator": "^1.4.4",
    "three": "0.187.0"
  }
}
